# agena - a small Gemini server
#
#   make -f Makefile.fpc              build with TaurusTLS (TLS 1.3), default
#   make -f Makefile.fpc USE_TAURUS=0 build against Indy's OpenSSL 1.0.x
#   make -f Makefile.fpc check        verify prerequisites and submodules
#   make -f Makefile.fpc clean
#
# FPC is a prerequisite; Indy and TaurusTLS are vendored as git submodules.

FPC        ?= fpc
USE_TAURUS ?= 1

INDY   := third_party/Indy/Lib
TAURUS := third_party/TaurusTLS/Source

BUILDDIR := build
TARGET   := $(BUILDDIR)/agena
UNITS    := $(BUILDDIR)/units

AGENA_UNITS := $(wildcard src/Units/*.pas)

PATHS := -Fu$(INDY)/Core -Fu$(INDY)/System -Fu$(INDY)/Protocols \
         -Fu$(INDY)/Security
INCS  := -Fi$(INDY)/Core -Fi$(INDY)/Protocols -Fi$(INDY)/Security

ifeq ($(USE_TAURUS),1)
FPCOPT := -dUSE_TAURUS
PATHS += -Fu$(TAURUS)
endif

.PHONY: all clean check

all: $(TARGET)

$(TARGET): src/agena.lpr $(AGENA_UNITS)
	mkdir -p $(BUILDDIR) $(UNITS)
	$(FPC) -Mdelphi -O2 -g -gl $(FPCOPT) \
	  -FU$(UNITS) -FE$(BUILDDIR) -Fusrc/Units \
	  $(PATHS) $(INCS) $<

check:
	@command -v $(FPC) >/dev/null || { echo "fpc not found in PATH"; exit 1; }
	@test -d third_party/Indy || { echo "missing submodule: Indy"; exit 1; }
	@if [ "$(USE_TAURUS)" = "1" ]; then \
	   test -d third_party/TaurusTLS || { echo "missing submodule: TaurusTLS"; exit 1; }; \
	 fi
	@echo "all dependencies present"

clean:
	rm -rf $(BUILDDIR)
